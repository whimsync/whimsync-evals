# whimsync-evals configuration. Copy to `.env` (gitignored) and fill in.
# Both suites expect the whimsync repo checked out next to this one: ../whimsync

# --- Gemini (required for the smart/max parser tiers and the claims benchmark) ---
GEMINI_API_KEY="your_gemini_api_key_here"

# --- Document parser benchmark (parser/) ---
# Vision model used by the smart/max tiers. Override per run with --model.
GEMINI_MODEL="gemini-3.5-flash"
# Max VLM requests started per minute (0 = unlimited). Free-tier keys allow
# ~15 RPM per model, so use 12 there. Override per run with --rpm.
VLM_RPM=12

# --- Claim extractor benchmark (claims/) ---
# Model for the single structured extraction call (apps/worker llmService).
LLM_MODEL="gemini-3.5-flash-lite"
# Embedding model used to match predicted claims to expected ones.
EMBEDDING_MODEL="gemini-embedding-2"
