# whimsync-evals configuration. Copy to `.env` (gitignored) and fill in.
# The parser runs in Docker (extractor-eval image build). The claims suite imports ../whimsync.

# --- Gemini (required for the VLM tiers, the judge and the claims benchmark) ---
GEMINI_API_KEY="your_gemini_api_key_here"

# --- Document parser (extractor/, forwarded into the container) ---
# Vision model used by the balanced/max tiers. Override per run with --model.
GEMINI_MODEL="gemini-3.5-flash"
# Max VLM requests started per minute (0 = unlimited). Free-tier keys allow
# ~15 RPM per model, so use 12 there.
VLM_RPM=12

# --- Gemini judge (extractor-eval) ---
JUDGE_MODEL="gemini-3.8-flash"
JUDGE_TEMPERATURE=0
JUDGE_RPM=12

# --- Claim extractor benchmark (claims/) ---
# Model for the single structured extraction call (apps/worker llmService).
LLM_MODEL="gemini-3.5-flash-lite"
# Embedding model used to match predicted claims to expected ones.
EMBEDDING_MODEL="gemini-embedding-2"
